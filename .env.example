# Copy this file to .env and fill in your key.
# cp .env.example .env

# Required for the full reasoning core (missions, open conversation).
# Free keys: https://console.groq.com  — any OpenAI-compatible endpoint works.
API_KEY=your_api_key_here

# Optional overrides.
# ALICE_MODEL=llama-3.3-70b-versatile
# ALICE_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# ALICE_DATA_DIR=data

# Web UI (python -m server)
# ALICE_HOST=0.0.0.0
# ALICE_PORT=8000

# Agent limits
# ALICE_AGENT_MAX_STEPS=24
# ALICE_AGENT_ROUNDS_PER_STEP=5
# ALICE_AGENT_ASK_TIMEOUT=600
